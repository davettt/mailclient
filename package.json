{
  "name": "mailclient",
  "version": "0.4.4",
  "license": "MIT",
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "build": "npm run build:server && npm run build:client && node -e \"require('fs').writeFileSync('.last-build',Date.now().toString())\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "start": "node dist/server/index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop mailclient",
    "pm2:restart": "pm2 restart mailclient",
    "pm2:logs": "pm2 logs mailclient",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "security": "npm audit --audit-level=high --omit=dev",
    "quality": "npm run lint && npm run format:check && npm run type-check",
    "sast": "semgrep scan --config auto --error --quiet --exclude-rule javascript.lang.security.audit.path-traversal.path-join-resolve-traversal.path-join-resolve-traversal --exclude-rule javascript.express.security.audit.express-path-join-resolve-traversal.express-path-join-resolve-traversal --exclude-rule javascript.express.security.audit.express-res-sendfile.express-res-sendfile --exclude-rule javascript.express.security.audit.remote-property-injection.remote-property-injection",
    "secrets": "betterleaks git . -v",
    "licenses": "license-checker --production --failOn 'GPL-2.0;GPL-3.0;AGPL-1.0;AGPL-3.0' --summary",
    "licenses:file": "license-checker --production > THIRD-PARTY-LICENSES.txt",
    "deps:check": "node ../build-policy/scripts/check-allowlist.js .",
    "deps:verify": "node ../build-policy/scripts/verify-package.js",
    "review": "coderabbit review --agent --include-untracked",
    "prepare": "husky",
    "lint:html": "html-validate *.html",
    "validate": "npm run lint && npm run lint:html && npm run format:check && npm run type-check",
    "test:smoke": "node tests/harness.js",
    "socket:scan": "socket ci"
  },
  "dependencies": {
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-placeholder": "^3.22.4",
    "@tiptap/extension-underline": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dompurify": "^3.4.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "imapflow": "^1.0.167",
    "mailparser": "^3.7.1",
    "nodemailer": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^14.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-security": "^4.0.1",
    "html-validate": "^11.5.6",
    "husky": "^9.1.7",
    "license-checker": "^25.0.1",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
